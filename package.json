{
  "name": "allamashraf-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs",
    "format": "prettier --write",
    "format:staged": "node scripts/check-staged-format.mjs",
    "precommit": "node scripts/pre-commit.mjs",
    "dev": "node scripts/build-client.mjs && astro dev",
    "build": "node scripts/build-client.mjs && astro build",
    "build:prod": "node scripts/build-prod.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "check:claims": "node scripts/check-claims.mjs",
    "check:budgets": "node scripts/check-budgets.mjs",
    "check:history": "node scripts/check-history.mjs",
    "check:release": "node scripts/check-release.mjs",
    "check:lcp-scripts": "node scripts/check-lcp-scripts.mjs",
    "test": "npm run test:unit && playwright test",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "lhci": "lhci autorun"
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.1",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "astro": "7.4.2",
    "gsap": "3.15.0"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "typescript": "6.0.3",
    "yaml": "2.9.1"
  }
}
