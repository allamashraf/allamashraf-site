---
interface Props { kind: 'hotel' | 'routing' | 'showroom' }
const { kind } = Astro.props;
// Schematic labels describe the actual case, not the reference's fictional systems.
const nodes = kind === 'showroom' ? ['TOUCH', 'VIDEO', 'IDLE'] : kind === 'hotel' ? ['AR', 'EN', 'TRACK'] : ['SCORE', 'DEDUP', 'ROUTE'];
---
<svg class:list={['mobile-schematic', `mobile-vt-${kind}`]} viewBox="0 0 320 138" aria-hidden="true">
  <defs><pattern id={`dots-${kind}`} width="12" height="12" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r=".55" fill="#c4ff00" opacity=".22" /></pattern></defs>
  <rect width="320" height="138" fill={`url(#dots-${kind})`} />
  <g fill="none" stroke="#c4ff00" stroke-width=".8">
    <path d="M62 34 C90 34 88 69 122 69 M62 104 C92 104 88 69 122 69 M168 69 H198 M236 69 C260 69 246 28 270 28 M236 69 H270 M236 69 C260 69 246 110 270 110" />
    <rect x="10" y="20" width="52" height="28" rx="5" /><rect x="10" y="90" width="52" height="28" rx="5" />
    <rect x="122" y="46" width="46" height="46" rx="6" /><rect x="198" y="50" width="38" height="38" rx="5" />
    <rect x="270" y="14" width="40" height="28" rx="5" stroke="#686868" /><rect x="270" y="55" width="40" height="28" rx="5" stroke="#686868" /><rect x="270" y="96" width="40" height="28" rx="5" stroke="#686868" />
    {kind === 'showroom' ? <><rect x="131" y="56" width="28" height="20" rx="1" /><path d="M145 76 V82 M138 82 H152 M139 61 L139 71 L149 66 Z" /></> : kind === 'hotel' ? <><path d="M135 58 H155 M135 65 H151 M135 72 H155 M135 79 H148" /><path d="M205 67 l5 5 12 -12" /></> : <><ellipse cx="145" cy="59" rx="10" ry="4" /><path d="M135 59 V78 C135 84 155 84 155 78 V59 M135 67 C135 73 155 73 155 67 M135 74 C135 80 155 80 155 74" /></>}
    <circle cx="217" cy="61" r="3" /><path d="M217 64 V72 M207 78 V72 H227 V78" /><rect x="204" y="78" width="6" height="5" /><rect x="224" y="78" width="6" height="5" />
  </g>
  <g fill="#f2efe7" font-family="monospace" font-size="7" text-anchor="middle">
    <text x="36" y="37">{nodes[0]}</text><text x="36" y="107">{nodes[1]}</text>
    {nodes.map((node,i) => <text x="290" y={31+i*41}>{node}</text>)}
  </g>
</svg>
<style>
  .mobile-schematic { display: none; }
  @media(max-width:767px) {
    .mobile-schematic { display: block; width: 100%; height: auto; }
    .mobile-vt-showroom { view-transition-name: cover-showroom; }
    .mobile-vt-hotel { view-transition-name: cover-hotel; }
    .mobile-vt-routing { view-transition-name: cover-routing; }
  }
</style>
