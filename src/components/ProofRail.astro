---
import { getCollection } from 'astro:content';
import StatusBadge from './StatusBadge.astro';

const cases = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<nav class="rail" aria-label="Case studies">
  <ol class="rail__list">
    {
      cases.map((c) => (
        <li class="rail__item">
          <a class="rail__link" href={`/work/${c.id}/`}>
            <span class="rail__num mono">{String(c.data.order).padStart(2, '0')}</span>
            <span class="rail__title">{c.data.shortTitle}</span>
            <StatusBadge status={c.data.projectStatus} class="rail__badge" />
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .rail {
    margin-top: auto;
    padding-bottom: var(--s-5);
  }

  .rail__list {
    display: grid;
    border-top: 1px solid var(--line-inactive);
  }

  .rail__item + .rail__item {
    border-top: 1px solid var(--hairline);
  }

  .rail__link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--s-4);
    min-height: 56px;
    padding-block: var(--s-3);
    text-decoration: none;
    font-family: var(--ff-display);
    font-weight: 500;
    font-size: 1.125rem;
    line-height: 1.2;
  }

  .rail__num {
    color: var(--muted);
  }

  @media (max-width: 767px) {
    .rail {
      padding-bottom: var(--s-3);
    }

    .rail__link {
      gap: var(--s-2);
      min-height: 44px;
      padding-block: var(--s-1);
      font-size: 0.9375rem;
      letter-spacing: -0.01em;
    }

    .rail__link :global(.badge) {
      font-size: 0.6875rem;
      padding: 2px var(--s-2);
    }
  }

  .rail__link:hover .rail__title {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
  }

  @media (min-width: 1024px) {
    .rail__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .rail__item + .rail__item {
      border-top: 0;
      border-inline-start: 1px solid var(--hairline);
    }

    .rail__link {
      padding-inline: var(--s-4);
      min-height: 72px;
    }

    .rail__item:first-child .rail__link {
      padding-inline-start: 0;
    }
  }
</style>
