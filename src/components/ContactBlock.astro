---
import { SITE, emailPublished } from '../config/site';
import { contact } from '../content/copy';
import Claim from './Claim.astro';
import CopyEmail from './CopyEmail.astro';
---

<section class="section contact" id="contact" aria-labelledby="contact-title">
  <div class="container">
    <p class="coord mono">05 / Contact</p>
    <h2 id="contact-title" class="contact__title">{contact.title}</h2>
    <div class="grid contact__grid">
      <div class="contact__channels">
        {emailPublished && <CopyEmail />}
        <p class="contact__linkedin">
          {
            SITE.linkedinUrl ? (
              <a class="btn" href={SITE.linkedinUrl} rel="me" data-linkedin>
                {contact.linkedin} <span class="arrow" aria-hidden="true">↗</span>
              </a>
            ) : (
              <Claim id="linkedin-url" />
            )
          }
        </p>
      </div>
      <div class="contact__facts">
        <p class="contact__availability" data-availability>{SITE.availability}</p>
        <p class="muted">Based in {SITE.location}.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    border-top: 1px solid var(--hairline);
  }

  .contact__title {
    font-size: clamp(2.75rem, 7vw + 0.5rem, 8.5rem);
    line-height: 0.94;
    letter-spacing: -0.03em;
    max-width: 14ch;
    margin-bottom: var(--s-8);
  }

  .contact__grid {
    row-gap: var(--s-7);
  }

  .contact__channels,
  .contact__facts {
    grid-column: 1 / -1;
    display: grid;
    gap: var(--s-5);
    align-content: start;
  }

  .contact__availability {
    font-family: var(--ff-display);
    font-weight: 500;
    font-size: clamp(1.25rem, 1vw + 1rem, 1.75rem);
    line-height: 1.3;
    max-width: 30ch;
  }

  @media (min-width: 1024px) {
    .contact__channels {
      grid-column: 1 / span 6;
    }
    .contact__facts {
      grid-column: 8 / -1;
    }
  }

  /* Mobile pass (approved by Allam): tighter gap under the heading on phones. */
  @media (max-width: 767px) {
    .contact__title {
      margin-bottom: var(--s-6);
    }
  }
</style>
