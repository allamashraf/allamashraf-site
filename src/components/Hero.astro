---
import { hero, contact, capabilities } from '../content/copy';
import { SITE, emailPublished } from '../config/site';
import ProofRail from './ProofRail.astro';
import Claim from './Claim.astro';
import MobileParticles from './MobileParticles.astro';

// Words are wrapped server-side for the CSS mask reveal; the text itself is unchanged.
const words = hero.h1.split(' ');
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__grid container" aria-hidden="true">
    <div class="grid hero__grid-cols">
      {Array.from({ length: 12 }, () => (
        <span />
      ))}
    </div>
  </div>

  <div class="container hero__inner">
    <p class="hero__eyebrow mono">{hero.eyebrow}</p>
    <!-- The word spans exist only for the reveal. Firefox drops the space at each wrapped
         inline-block, so the heading's name comes from aria-label, not the rendered words. -->
    <h1 id="hero-title" class="hero__title" aria-label={hero.h1}>
      <span aria-hidden="true">
        {words.map((w, i) => (
          <>
            <span class="w">
              <span class="w__in">{w}</span>
            </span>
            {i < words.length - 1 ? ' ' : ''}
          </>
        ))}
      </span>
      <span class="hero__dot" aria-hidden="true"></span>
    </h1>
    <div class="grid hero__foot">
      <p class="hero__subhead lede">
        <span class="hero__subhead-full">
          <Claim id={hero.subheadClaim} />
        </span>
        <span class="hero__subhead-short">
          <Claim id={hero.subheadMobileClaim} />
        </span>
      </p>
      <div class="hero__ctas">
        <a class="btn btn--primary" href="#work">
          {hero.primaryCta}
        </a>
        <a class="btn hero__resume" href={SITE.resumeUrl} download>
          Resume <span class="mono">PDF ↓</span>
        </a>
        {SITE.linkedinUrl && (
          <a class="btn mobile-linkedin" href={SITE.linkedinUrl} rel="me">
            {contact.linkedin}
            <span aria-hidden="true">↗</span>
          </a>
        )}
        {emailPublished ? (
          <a class="btn" href={`mailto:${SITE.email}`}>
            {hero.emailCta}
          </a>
        ) : (
          <a class="btn" href="#contact">
            {hero.contactCta}
          </a>
        )}
      </div>
    </div>
    <ProofRail />
    <div class="mobile-credentials" aria-hidden="true">
      {capabilities.groups.map((group) => (
        <span>{group.title}</span>
      ))}
    </div>
    <MobileParticles kind="wave" />
  </div>
</section>
<a class="skip-anim mono" href="#work">
  Skip the animation <span aria-hidden="true">→</span> Work
</a>

<style>
  .mobile-linkedin,
  .mobile-credentials {
    display: none;
  }
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    padding-top: calc(var(--header-h) + var(--s-6));
    overflow: clip;
  }

  /* Faint static hairline grid, Hero only (§4.4). Aligned to the real columns. */
  .hero__grid {
    position: absolute;
    inset: 0;
    margin-inline: auto;
    pointer-events: none;
  }

  .hero__grid-cols {
    height: 100%;
  }

  .hero__grid-cols span {
    border-inline-start: 1px solid var(--hairline);
    opacity: 0.55;
  }

  .hero__grid-cols span:nth-child(n + 5) {
    display: none;
  }

  @media (min-width: 1024px) {
    .hero__grid-cols span:nth-child(n + 5) {
      display: block;
    }
    .hero__grid-cols span:last-child {
      border-inline-end: 1px solid var(--hairline);
    }
  }

  @media (max-width: 1023px) {
    .hero__grid-cols span:nth-child(4) {
      border-inline-end: 1px solid var(--hairline);
    }
  }

  .hero__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
  }

  .hero__eyebrow {
    color: var(--muted);
  }

  .hero__title {
    font-size: var(--fs-h1);
    line-height: 0.92;
    letter-spacing: -0.03em;
    font-weight: 600;
    max-width: 15ch;
    text-wrap: balance;
  }

  /* H1 reveal (§8.3): each word rises inside its own clip, opacity stays 1, CSS only.
     Words start 55% risen so the H1 (the LCP element) paints on the first frame.
     Padding/negative margin keep ascenders and descenders outside the clip edge. */
  .hero__title .w {
    display: inline-block;
    overflow: clip;
    padding: 0.08em 0 0.16em;
    margin: -0.08em 0 -0.16em;
    vertical-align: top;
  }

  .hero__title .w__in {
    display: inline-block;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__title .w__in {
      animation: word-rise 650ms var(--ease) both;
    }

    .hero__title .w:nth-child(2) .w__in {
      animation-delay: 30ms;
    }
    .hero__title .w:nth-child(3) .w__in {
      animation-delay: 60ms;
    }
    .hero__title .w:nth-child(4) .w__in {
      animation-delay: 90ms;
    }
    .hero__title .w:nth-child(5) .w__in {
      animation-delay: 120ms;
    }
    .hero__title .w:nth-child(6) .w__in {
      animation-delay: 150ms;
    }
    .hero__title .w:nth-child(7) .w__in {
      animation-delay: 180ms;
    }
    .hero__title .w:nth-child(8) .w__in {
      animation-delay: 210ms;
    }
    .hero__title .w:nth-child(9) .w__in {
      animation-delay: 240ms;
    }
    .hero__title .w:nth-child(10) .w__in {
      animation-delay: 270ms;
    }
    .hero__title .w:nth-child(11) .w__in {
      animation-delay: 300ms;
    }
    .hero__title .w:nth-child(12) .w__in {
      animation-delay: 330ms;
    }
    .hero__title .w:nth-child(13) .w__in {
      animation-delay: 360ms;
    }
    .hero__title .w:nth-child(n + 14) .w__in {
      animation-delay: 390ms;
    }
  }

  @keyframes word-rise {
    from {
      transform: translateY(55%);
    }
    to {
      transform: none;
    }
  }

  .hero__dot {
    position: relative;
    display: inline-block;
    width: 0.16em;
    height: 0.16em;
    margin-inline-start: 0.06em;
    border-radius: 50%;
    background: var(--accent);
  }

  /* The pulse: a few beats on load, then still. Never a constant loop (§8.3 banned list). */
  .hero__dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid var(--accent);
    opacity: 0;
    animation: dot-pulse 1.6s var(--ease) 0.8s 4;
  }

  @keyframes dot-pulse {
    0% {
      transform: scale(1);
      opacity: 0.8;
    }
    100% {
      transform: scale(3.2);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__dot::after {
      animation: none;
    }
  }

  .hero__foot {
    row-gap: var(--s-5);
    align-items: end;
  }

  .hero__subhead {
    grid-column: 1 / -1;
    max-width: 58ch;
  }

  .hero__ctas {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }

  .hero__subhead-short {
    display: none;
  }

  /* Phones: keep the proof rail inside the first viewport (§5 section 1).
     Mobile pass (approved by Allam): content height instead of 100svh, so the start of the
     Signal Path shows on the first screen, a 40px H1 and the shorter subhead.
     Placed after the base rules so it wins the cascade. */
  @media (max-width: 767px) {
    .hero {
      min-height: 0;
      padding-top: calc(var(--header-h) + var(--s-4));
    }

    /* The hero now ends mid-screen; fade the hairlines instead of cutting them off. */
    .hero__grid {
      mask-image: linear-gradient(to bottom, #000 70%, transparent);
    }

    .hero__inner {
      gap: var(--s-4);
    }

    .hero__eyebrow {
      font-size: 0.6875rem;
      letter-spacing: 0.06em;
    }

    .hero__title {
      font-size: clamp(2.5rem, 8.5vw + 0.5rem, 10rem);
    }

    .hero__subhead {
      font-size: 0.9375rem;
      line-height: 1.42;
    }

    .hero__subhead-full {
      display: none;
    }

    .hero__subhead-short {
      display: inline;
    }

    .hero__foot {
      row-gap: var(--s-4);
    }
  }

  @media (min-width: 1024px) {
    /* The approved subhead runs five lines at 1440; keep the proof rail inside 900px. */
    .hero {
      padding-top: calc(var(--header-h) + var(--s-5));
    }
    .hero__inner {
      gap: var(--s-4);
    }
    .hero__subhead {
      grid-column: 1 / span 7;
      max-width: 62ch;
    }
    .hero__ctas {
      grid-column: 9 / -1;
      justify-content: flex-end;
    }
  }

  /* Keyboard-only: clipped until focused (never opacity 0, so nothing is "hidden content"). */
  .skip-anim {
    position: absolute;
    left: var(--gutter);
    padding: var(--s-3) var(--s-4);
    background: var(--surface);
    color: var(--text);
    white-space: nowrap;
    clip-path: inset(50%);
    transform: translateY(-140%);
  }

  .skip-anim:focus-visible {
    clip-path: none;
    z-index: 5;
  }

  @media (max-width: 767px) {
    .hero {
      padding-top: 148px;
      background: #050606;
    }
    .hero__grid {
      display: none;
    }
    .hero__inner {
      gap: 22px;
    }
    .hero__eyebrow {
      display: flex;
      align-items: center;
      gap: 9px;
      font-size: 10px;
      letter-spacing: 0.015em;
    }
    .hero__eyebrow::before {
      content: '';
      width: 18px;
      height: 1px;
      flex-shrink: 0;
      background: var(--accent);
    }
    .hero__title {
      font-family: var(--ff-body);
      font-weight: 500;
      line-height: 1.06;
      letter-spacing: -0.03em;
      max-width: none;
      text-wrap: initial;
    }
    .hero__dot {
      display: none;
    }
    .hero__subhead {
      font-family: var(--ff-mono);
      font-size: 12px;
      line-height: 1.7;
    }
    .hero__foot {
      row-gap: 28px;
    }
    .hero__ctas {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }
    .hero__ctas > .btn {
      border-radius: 999px;
      justify-content: space-between;
      min-height: 44px;
      font-family: var(--ff-body);
      font-size: 13px;
      text-transform: none;
      letter-spacing: 0.02em;
      padding: 10px 22px;
    }
    .hero__ctas > .btn:first-child::after {
      content: '→';
    }
    .hero__ctas > .btn--primary {
      box-shadow: 0 0 32px #c4ff002b;
    }
    .hero__ctas > .btn:not(:first-child):not(.mobile-linkedin):not(.hero__resume) {
      display: none;
    }
    .hero__ctas > .hero__resume {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    .hero__ctas > .mobile-linkedin {
      display: inline-flex;
      border-color: #c0c0ba;
    }
    .hero__inner > :global(.rail) {
      display: none;
    }
    .mobile-credentials {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      margin-top: 12px;
    }
    .mobile-credentials span {
      position: relative;
      border-right: 1px solid #303030;
      padding: 5px 5px 5px 12px;
      font: 500 7px/1.7 var(--ff-mono);
      text-transform: uppercase;
    }
    .mobile-credentials span::before {
      content: '';
      position: absolute;
      width: 5px;
      height: 5px;
      border-radius: 50%;
      left: 0;
      top: 10px;
      background: var(--accent);
    }
    .mobile-credentials span:last-child {
      border: 0;
    }
  }
  @media (max-width: 359px) {
    .hero__ctas > .btn {
      padding-inline: 14px;
      font-size: 12px;
      gap: 8px;
      white-space: nowrap;
    }
  }
</style>
